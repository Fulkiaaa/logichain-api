meta {
  name: Create event
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Festival des Verts 2026",
    "slug": "festival-verts-2026",
    "startDate": "2026-06-01T00:00:00.000Z",
    "endDate": "2026-06-05T00:00:00.000Z",
    "expectedAttendance": 12000,
    "managerId": "{{$randomUuid}}",
    "zones": [
      {
        "name": "Grande scène",
        "category": "stage",
        "capacity": 8000,
        "area": {
          "type": "Polygon",
          "coordinates": [[[2.34, 48.85],[2.36, 48.85],[2.36, 48.87],[2.34, 48.87],[2.34, 48.85]]]
        }
      }
    ]
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("eventId", res.body.id);
  }
}
