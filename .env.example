# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MongoDB (replica set rs0 obligatoire pour Change Streams + transactions ACID)
#
# Pour le dev local (npm run dev sur l'host, mongo dans Docker) :
#   MONGO_URI=mongodb://localhost:27017/logichain?directConnection=true
#
# Pour le runtime Docker (API dans le compose, mongo dans le compose) :
#   MONGO_URI=mongodb://mongo:27017/logichain?replicaSet=rs0
#
# directConnection=true évite la découverte du replica set côté driver (qui
# annonce l'hostname "mongo" interne au compose, non résoluble depuis l'host).
MONGO_URI=mongodb://localhost:27017/logichain?directConnection=true

# Auth
# Génère un secret robuste : openssl rand -base64 64
JWT_SECRET=change-me-please-openssl-rand-base64-64
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# CORS (origin du futur front PWA)
CORS_ORIGIN=https://logichain.fulkia.fr

# Bcrypt
BCRYPT_ROUNDS=12

# Documentation API (/docs et /openapi.json)
# Si les DEUX sont définis, la doc est protégée par Basic Auth.
# Si l'un est absent, la doc reste ouverte (pratique en dev) → à définir en prod.
DOCS_USER=
DOCS_PASSWORD=

# Seed (scripts/seed.ts) — mot de passe commun des comptes créés par `npm run seed`
SEED_PASSWORD=LogiChain2026!
